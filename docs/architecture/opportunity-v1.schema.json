{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PolyFork Opportunity v1",
  "description": "Normalized read-only opportunity between one prediction-market leg and one bookmaker leg. Published additively by the canonical backend and consumed by the dashboard list-card dual-read.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "status",
    "observed_at",
    "computed_at",
    "market",
    "mapping",
    "legs",
    "calculation"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1, "maxLength": 768},
    "status": {"enum": ["active", "stale", "suspended", "withdrawn"]},
    "observed_at": {"$ref": "#/$defs/dateTime"},
    "computed_at": {"$ref": "#/$defs/dateTime"},
    "market": {"$ref": "#/$defs/market"},
    "mapping": {"$ref": "#/$defs/mapping"},
    "legs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/legBase"},
          {
            "oneOf": [
              {"$ref": "#/$defs/predictionMarketLeg"},
              {"$ref": "#/$defs/bookmakerLeg"}
            ]
          }
        ]
      },
      "contains": {"properties": {"source_kind": {"const": "prediction_market"}}, "required": ["source_kind"]},
      "minContains": 1,
      "maxContains": 1,
      "allOf": [
        {
          "contains": {"properties": {"source_kind": {"const": "bookmaker"}}, "required": ["source_kind"]},
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "calculation": {"$ref": "#/$defs/calculation"},
    "diagnostics": {
      "type": "array",
      "items": {"type": "string", "maxLength": 160},
      "default": []
    }
  },
  "$defs": {
    "dateTime": {"type": "string", "format": "date-time"},
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "question", "sport", "market_type", "phase"],
      "properties": {
        "slug": {"type": "string", "minLength": 1, "maxLength": 512},
        "question": {"type": "string", "minLength": 1, "maxLength": 500},
        "sport": {"type": "string", "minLength": 1, "maxLength": 80},
        "market_type": {"type": "string", "minLength": 1, "maxLength": 80},
        "phase": {"enum": ["live", "prematch", "unknown"]},
        "starts_at": {"oneOf": [{"$ref": "#/$defs/dateTime"}, {"type": "null"}]}
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method", "reason_codes"],
      "properties": {
        "status": {"enum": ["accepted", "rejected", "ambiguous"]},
        "method": {"enum": ["manual", "automated", "manual_alias", "unknown"]},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "reason_codes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 100},
          "uniqueItems": true
        }
      }
    },
    "legBase": {
      "type": "object",
      "required": ["source", "source_kind", "outcome", "price", "price_unit", "stake", "currency", "observed_at", "age_ms", "timestamp_basis"],
      "properties": {
        "source": {"type": "string", "minLength": 1, "maxLength": 80},
        "source_kind": {"enum": ["prediction_market", "bookmaker"]},
        "outcome": {"type": "string", "minLength": 1, "maxLength": 200},
        "price": {"type": "number", "exclusiveMinimum": 0, "description": "Observed price for this leg in the units declared by price_unit; a Polymarket probability is USDT-equivalent per share, while a bookmaker price is decimal odds."},
        "price_unit": {"enum": ["probability", "decimal_odds"]},
        "stake": {"type": "number", "minimum": 0, "description": "Planned monetary allocation to this leg, denominated in currency; not the account-wide bankroll."},
        "currency": {"enum": ["USDT", "USD", "RUB"]},
        "observed_at": {"$ref": "#/$defs/dateTime"},
        "age_ms": {"type": "number", "minimum": 0},
        "timestamp_basis": {"enum": ["provider", "received_at"]},
        "provider_observed_at": {"oneOf": [{"$ref": "#/$defs/dateTime"}, {"type": "null"}]},
        "calculation_input_multiplier": {"type": "number", "exclusiveMinimum": 1, "description": "Exact legacy bets[].o input passed to eff_mult for replay. For Polymarket it is already a fee-adjusted odds-like multiplier; do not apply fee_fraction a second time."},
        "commission_fraction": {"type": "number", "minimum": 0, "exclusiveMaximum": 1, "description": "Legacy bets[].c input passed to eff_mult; dimensionless fraction, not a currency amount."},
        "slippage_fraction": {"type": "number", "minimum": 0, "exclusiveMaximum": 1, "description": "Legacy bets[].s input passed to eff_mult; dimensionless fraction, not stake."},
        "available_size": {"type": ["number", "null"], "minimum": 0},
        "event_url": {"type": "string", "format": "uri", "maxLength": 2048, "description": "Optional provider-native event page for this leg only. Consumers must validate HTTPS and the exact allowlisted origin for source; never reuse another leg's URL."}
      }
    },
    "predictionMarketLeg": {
      "type": "object",
      "properties": {
        "source_kind": {"const": "prediction_market"},
        "price_unit": {"const": "probability"},
        "price": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "price_basis": {"enum": ["top_of_book", "depth_average"], "description": "Identifies whether price is the observed top ask or an average across the order-book depth walk."},
        "price_size_shares": {"type": ["number", "null"], "minimum": 0, "description": "Optional share quantity used to derive a depth-average price; informational sizing context, not an order or fill."},
        "token_id": {"type": "string", "minLength": 1, "maxLength": 256}
      },
      "required": ["token_id"]
    },
    "bookmakerLeg": {
      "type": "object",
      "properties": {
        "source_kind": {"const": "bookmaker"},
        "price_unit": {"const": "decimal_odds"},
        "price": {"type": "number", "exclusiveMinimum": 1}
      }
    },
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roi_fraction", "total_stake", "projected_profit", "currency", "fee_fraction", "pm_fee_schedule", "model_version"],
      "properties": {
        "roi_fraction": {"type": "number", "description": "Dimensionless projected return fraction, not percentage: 0.04 means 4%; intended to equal projected_profit divided by total_stake under the declared calculation model."},
        "total_stake": {"type": "number", "minimum": 0, "description": "Sum of legs[].stake in calculation.currency for this opportunity; not the user's account-wide bankroll or stake limit."},
        "projected_profit": {"type": "number", "description": "Pre-execution modelled net profit in calculation.currency; not realized P&L and not a guarantee of fills or returns."},
        "currency": {"enum": ["USDT", "USD", "RUB"]},
        "fee_fraction": {"type": "number", "minimum": 0, "maximum": 1, "description": "Compatibility alias for the market's feeSchedule.rate coefficient when enabled; not the effective percentage of stake paid as fees. Use pm_fee_schedule with price and exponent for fee estimates."},
        "pm_fee_schedule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "rate", "exponent", "source"],
          "properties": {
            "enabled": {"type": "boolean"},
            "rate": {"type": "number", "minimum": 0, "maximum": 1},
            "exponent": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
            "source": {"const": "clob_market_info"}
          },
          "description": "Per-market CLOB fee curve; estimated fee per share is rate * (p * (1-p)) ** exponent for taker fills."
        },
        "model_version": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    }
  }
}
